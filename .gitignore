__pycache__/
*.pyc
*.egg-info/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/
# model / data caches and run outputs (never commit)
runs/
outputs/
cache/
*.safetensors
*.bin
*.npz
!data/**/*.npz
# the State 2143 token sequence is fetched at runtime, never committed
data/state2143/sequence_tokens.json
data/state2143/*.bin
.env
# user-supplied corpora and extractions (never committed); only the extension-less
# README note of each drop folder is tracked (no loader matches that name)
data/ttt/dao_fork/*
!data/ttt/dao_fork/README
data/ttt/neutral/*
!data/ttt/neutral/README
data/ttt/nofork/*
!data/ttt/nofork/README
data/atlas/*
!data/atlas/README
data/s4/*
!data/s4/README
